# GMGN OpenAPI — sign-in & data
GMGN_API_KEY=your_api_key_here
# GMGN_PRIVATE_KEY is a request-signing Ed25519 key (NOT a wallet private key).
# Get keypair: openssl genpkey -algorithm ed25519 -> upload pubkey at https://gmgn.ai/ai
GMGN_PRIVATE_KEY=

# --- Robinhood Chain RPC (Alchemy) ---
RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/your_alchemy_key_here

# --- Bot mode ---
# dry-run | live
MODE=dry-run

# Chain identifier used by gmgn-cli (sol/bsc/base/eth/robinhood/arc/stable)
CHAIN_ID=robinhood

# --- Telegram monitoring (optional, create via @BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- PostgreSQL (optional, for persistence) ---
DATABASE_URL=postgresql://bot:bot@localhost:5432/robinhood_bot
REDIS_URL=redis://localhost:6379