# GMGN OpenAPI — sign-in & data (wajib)
GMGN_API_KEY=your_api_key_here
# Ed25519 request-signing key (BUKAN wallet key).
# Isi isi file keypair.pem — format satu baris dengan \n literal, contoh:
# GMGN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4C...\n-----END PRIVATE KEY-----"
GMGN_PRIVATE_KEY=

# --- Robinhood Chain RPC (Alchemy, wajib) ---
# URL di-derive otomatis dari key ini. Override manual via RPC_URL kalau perlu.
ALCHEMY_API_KEY=

# --- Uniswap Trading API (untuk swap on-chain path utama) ---
UNISWAP_API_KEY=

# --- Telegram monitoring (opsional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Allowlist numeric user IDs, pisah koma. Kosong = semua user boleh.
TELEGRAM_ALLOWED_IDS=

# --- Bot ---
# Hanya banner startup. Mode runtime beneran ada di settings.json ("mode": "dry-run"|"live").
MODE=dry-run
CHAIN_ID=robinhood

# --- Opsional ---
# EVENTS_WS_ENABLED=true   # WS newHeads trigger (default off — boros Alchemy CU)
# SCAN_INTERVAL_MS=60000
# SETTINGS_FILE=/abs/path/settings.json
# WALLET_FILE=/abs/path/wallet.json
